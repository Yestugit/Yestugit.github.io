---
import { getImage } from "astro:assets";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import MusicPlayer from "@components/MusicPlayer.svelte";
import { siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import {
	BACKGROUND_DESKTOP_MAX_WIDTH,
	BACKGROUND_FADE_DURATION_MS,
	BACKGROUND_MOBILE_MAX_WIDTH,
	BACKGROUND_ROTATION_INTERVAL_MS,
	BACKGROUND_WEBP_QUALITY,
	SITE_BACKGROUNDS,
} from "../data/site-backgrounds";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
const optimizedSiteBackgrounds = await Promise.all(
	SITE_BACKGROUNDS.map(async (src) => {
		const mobileWidth = Math.min(src.width, BACKGROUND_MOBILE_MAX_WIDTH);
		const desktopWidth = Math.min(src.width, BACKGROUND_DESKTOP_MAX_WIDTH);
		const [mobile, desktop] = await Promise.all([
			getImage({
				src,
				width: mobileWidth,
				format: "webp",
				quality: BACKGROUND_WEBP_QUALITY,
			}),
			getImage({
				src,
				width: desktopWidth,
				format: "webp",
				quality: BACKGROUND_WEBP_QUALITY,
			}),
		]);
		return { mobile: mobile.src, desktop: desktop.src };
	}),
);
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} | ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.title;
}
const pageDescription = description || siteConfig.description;
const socialImageUrl = siteConfig.socialImage
	? new URL(siteConfig.socialImage, siteConfig.url).toString()
	: undefined;

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[15px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={pageDescription}>
		<meta name="author" content={siteConfig.author}>
		<link rel="canonical" href={Astro.url}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={pageDescription}>
		<meta property="og:locale" content={siteLang}>
		{socialImageUrl && <meta property="og:image" content={socialImageUrl}>}
		{socialImageUrl && <meta property="og:image:alt" content={`${siteConfig.title} 社交分享卡片`}>}
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"}>
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={pageDescription}>
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl}>}
		{socialImageUrl && <meta name="twitter:image:alt" content={`${siteConfig.title} 社交分享卡片`}>}

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<div id="site-background" aria-hidden="true">
			<div class="site-background-layer"></div>
			<div class="site-background-layer"></div>
		</div>
		<script is:inline define:vars={{optimizedSiteBackgrounds, BACKGROUND_ROTATION_INTERVAL_MS, BACKGROUND_FADE_DURATION_MS}}>
			(() => {
				if (window.__siteBackgroundRotatorInitialized) return;
				window.__siteBackgroundRotatorInitialized = true;

				const container = document.getElementById('site-background');
				const layers = Array.from(container?.querySelectorAll('.site-background-layer') || []);
				if (!container || layers.length !== 2 || optimizedSiteBackgrounds.length === 0) return;

				const STORAGE_KEY = 'site-background-rotation-v2';
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const loadedImages = new Map();
				const now = Date.now();
				let restoredFromSession = false;
				let currentIndex = Math.floor(Math.random() * optimizedSiteBackgrounds.length);
				let nextSwitchAt = now + BACKGROUND_ROTATION_INTERVAL_MS;
				let activeLayerIndex = 0;
				let rotationTimer = 0;
				let transitionCleanupTimer = 0;

				try {
					const stored = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || 'null');
					if (
						stored &&
						Number.isInteger(stored.index) &&
						stored.index >= 0 &&
						stored.index < optimizedSiteBackgrounds.length &&
						Number.isFinite(stored.nextSwitchAt)
					) {
						currentIndex = stored.index;
						nextSwitchAt = stored.nextSwitchAt;
						restoredFromSession = true;

						if (nextSwitchAt <= now) {
							const elapsedSteps = Math.floor((now - nextSwitchAt) / BACKGROUND_ROTATION_INTERVAL_MS) + 1;
							currentIndex = (currentIndex + elapsedSteps) % optimizedSiteBackgrounds.length;
							nextSwitchAt += elapsedSteps * BACKGROUND_ROTATION_INTERVAL_MS;
						}
					}
				} catch {
					// Ignore unavailable or malformed session storage and start a fresh rotation.
				}

				const persistRotation = () => {
					try {
						sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
							index: currentIndex,
							nextSwitchAt,
						}));
					} catch {
						// The background rotation still works when storage is unavailable.
					}
				};

				const getSource = (index) => {
					const background = optimizedSiteBackgrounds[index];
					const requiredWidth = window.innerWidth * Math.min(window.devicePixelRatio || 1, 2);
					return requiredWidth <= 1440 ? background.mobile : background.desktop;
				};

				const loadBackground = (index) => {
					const src = getSource(index);
					if (loadedImages.has(src)) return loadedImages.get(src);

					const promise = new Promise((resolve, reject) => {
						const image = new Image();
						image.decoding = 'async';
						image.onload = async () => {
							try {
								await image.decode?.();
							} catch {
								// The load event is sufficient when decode() is unavailable or rejects.
							}
							resolve(src);
						};
						image.onerror = () => reject(new Error(`Unable to load background: ${src}`));
						image.src = src;
					});
					loadedImages.set(src, promise);
					promise.catch(() => loadedImages.delete(src));
					return promise;
				};

				const preloadNext = () => {
					if (document.hidden || reducedMotion.matches) return;
					const nextIndex = (currentIndex + 1) % optimizedSiteBackgrounds.length;
					void loadBackground(nextIndex).catch(() => undefined);
				};

				const schedulePreload = () => {
					if ('requestIdleCallback' in window) {
						window.requestIdleCallback(preloadNext, { timeout: 5_000 });
					} else {
						window.setTimeout(preloadNext, 1_000);
					}
				};

				const scheduleRotation = () => {
					window.clearTimeout(rotationTimer);
					if (document.hidden || reducedMotion.matches) return;
					const remainingTime = Math.max(0, nextSwitchAt - Date.now());
					rotationTimer = window.setTimeout(rotate, remainingTime);
				};

				const showBackground = async (index, initial = false) => {
					const src = await loadBackground(index);
					const nextLayerIndex = initial ? activeLayerIndex : 1 - activeLayerIndex;
					const nextLayer = layers[nextLayerIndex];
					const previousLayer = layers[activeLayerIndex];
					nextLayer.style.backgroundImage = `url("${src}")`;

					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							nextLayer.classList.add('is-active');
							if (!initial) previousLayer.classList.remove('is-active');
						});
					});

					if (!initial) {
						activeLayerIndex = nextLayerIndex;
						window.clearTimeout(transitionCleanupTimer);
						transitionCleanupTimer = window.setTimeout(() => {
							previousLayer.style.backgroundImage = 'none';
						}, BACKGROUND_FADE_DURATION_MS + 100);
					}
					currentIndex = index;
				};

				async function rotate() {
					let changed = false;
					for (let offset = 1; offset < optimizedSiteBackgrounds.length; offset += 1) {
						const candidateIndex = (currentIndex + offset) % optimizedSiteBackgrounds.length;
						try {
							await showBackground(candidateIndex);
							changed = true;
							break;
						} catch {
							// Skip an unavailable image and keep the currently visible background.
						}
					}
					nextSwitchAt = Date.now() + BACKGROUND_ROTATION_INTERVAL_MS;
					persistRotation();
					if (changed) schedulePreload();
					scheduleRotation();
				}

				const start = async () => {
					persistRotation();
					if (restoredFromSession) {
						const src = getSource(currentIndex);
						layers[activeLayerIndex].style.backgroundImage = `url("${src}")`;
						layers[activeLayerIndex].classList.add('is-active');
						void loadBackground(currentIndex).catch(() => undefined);
						schedulePreload();
						scheduleRotation();
						return;
					}

					try {
						await showBackground(currentIndex, true);
						schedulePreload();
					} finally {
						scheduleRotation();
					}
				};

				document.addEventListener('visibilitychange', () => {
					if (document.hidden) {
						window.clearTimeout(rotationTimer);
					} else {
						schedulePreload();
						scheduleRotation();
					}
				});
				reducedMotion.addEventListener?.('change', scheduleRotation);
				void start();
			})();
		</script>
		<ConfigCarrier></ConfigCarrier>
		<slot />
		<MusicPlayer client:idle />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
	'background-fade-duration': `${BACKGROUND_FADE_DURATION_MS}ms`,
}}>
body {
	position: relative;
	isolation: isolate;
	background: transparent;
}

#site-background {
	position: fixed;
	inset: 0;
	z-index: -1;
	pointer-events: none;
	overflow: hidden;
	background: rgb(240 244 252);
}

.site-background-layer,
#site-background::after {
	position: absolute;
	inset: 0;
}

.site-background-layer {
	opacity: 0;
	background-position: center;
	background-size: cover;
	transition: opacity var(--background-fade-duration) ease-in-out;
	will-change: opacity;
}

.site-background-layer.is-active {
	opacity: 1;
}

#site-background::after {
	content: "";
	background: linear-gradient(rgb(247 246 251 / 0.38), rgb(240 244 252 / 0.44));
}

:root.dark #site-background {
	background: rgb(20 24 35);
}

:root.dark #site-background::after {
	background: linear-gradient(rgb(18 17 28 / 0.52), rgb(20 24 35 / 0.58));
}

@media (prefers-reduced-motion: reduce) {
	.site-background-layer {
		transition: none;
	}
}

@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import 'overlayscrollbars/overlayscrollbars.css';
import {
	OverlayScrollbars,
	// ScrollbarsHidingPlugin,
	// SizeObserverPlugin,
	// ClickScrollPlugin
} from 'overlayscrollbars';
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

/* Preload fonts */
// (async function() {
// 	try {
// 		await Promise.all([
// 			document.fonts.load("400 1em Roboto"),
// 			document.fonts.load("700 1em Roboto"),
// 		]);
// 		document.body.classList.remove("hidden");
// 	} catch (error) {
// 		console.log("Failed to load fonts:", error);
// 	}
// })();

/* TODO This is a temporary solution for style flicker issue when the transition is activated */
/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
/* update: fixed in Astro 3.2.4 */
/*
